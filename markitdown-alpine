# Use the official Alpine Linux image
FROM alpine:latest

# Update package index and install a package (e.g., curl or python)
RUN apk update && apk add --no-cache \
    python3 \
    py3-pip \
    build-base \
    libffi-dev \
    libxml2-dev \
    libxslt-dev
	
	
# Install Microsoft MarkItDown with all optional file format support (PDF, DOCX, XLSX, etc.)
RUN pip install --no-cache-dir --break-system-packages 'markitdown[all]'	
	
# Set the working directory inside the container
WORKDIR /app

# Copy local files into the container
COPY . /app


# Install Microsoft MarkItDown with all optional file format support (PDF, DOCX, XLSX, etc.)
RUN pip install --no-cache-dir --break-system-packages 'markitdown[all]'


# Default command displays usage
CMD ["markitdown", "--help"]


# Define the default command to run when the container starts
CMD ["python3", "-c", "print('Hello from Alpine Linux!')"]

